---
import BlurFade from "@/components/BlurFade.astro";
import SkillIcon from "@/components/icons/skills/SkillIcon.astro";
import { DATA } from "@/data/resume";

const BLUR_FADE_DELAY = 0.04;
---

<section id="skills">
  <div class="flex min-h-0 flex-col gap-y-4">
    <BlurFade delay={BLUR_FADE_DELAY * 9}>
      <h2 class="text-xl font-bold">Habilidades</h2>
    </BlurFade>
    <div class="flex flex-wrap gap-2">
      {
        DATA.skills.map((skill, id) => (
          <BlurFade delay={BLUR_FADE_DELAY * 10 + id * 0.05}>
            <div class="flex h-8 w-fit items-center gap-2 rounded-xl border border-border bg-background px-4 ring-2 ring-border/20">
              <SkillIcon name={skill.icon} class="size-4 overflow-hidden rounded object-contain" />
              <span class="text-sm font-medium text-foreground">{skill.name}</span>
            </div>
          </BlurFade>
        ))
      }
    </div>
  </div>
</section>
