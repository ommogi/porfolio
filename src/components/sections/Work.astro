---
import ChevronDown from "@/components/icons/ChevronDown.astro";
import { DATA } from "@/data/resume";
---

<div class="grid w-full gap-6" data-accordion>
  {
    DATA.work.map((work) => (
      <div class="grid w-full gap-2">
        <button
          type="button"
          data-accordion-trigger
          aria-expanded="false"
          class="flex w-full cursor-pointer items-center justify-between gap-x-3 p-0 text-left transition-colors"
        >
          <div class="flex min-w-0 flex-1 items-center gap-x-3">
            {
              work.logoUrl ? (
                <img
                  src={work.logoUrl}
                  alt={work.company}
                  class="size-8 shrink-0 overflow-hidden rounded-full border object-contain p-1 shadow ring-2 ring-border md:size-10"
                />
              ) : (
                <div class="size-8 shrink-0 overflow-hidden rounded-full border bg-muted shadow ring-2 ring-border md:size-10" />
              )
            }
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
              <div class="flex items-center gap-2 font-semibold leading-none">
                {work.company}
                <ChevronDown
                  data-accordion-chevron
                  class="h-3.5 w-3.5 shrink-0 stroke-2 text-muted-foreground transition-transform duration-200"
                />
              </div>
              <div class="font-sans text-sm text-muted-foreground">{work.title}</div>
            </div>
          </div>
          <div class="flex flex-none items-center gap-1 text-right text-xs tabular-nums text-muted-foreground">
            <span>
              {work.start} - {work.end ?? "Actualidad"}
            </span>
          </div>
        </button>
        <div data-accordion-content class="ml-13 overflow-hidden" style="height:0">
          <p class="pb-1 text-xs text-muted-foreground sm:text-sm">{work.description}</p>
        </div>
      </div>
    ))
  }
</div>

<script>
  import { gsap } from "gsap";

  function initAccordion(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-accordion-trigger]"));
    for (const trigger of items) {
      trigger.addEventListener("click", () => {
        const content = trigger.parentElement?.querySelector<HTMLElement>("[data-accordion-content]");
        const chevron = trigger.querySelector<HTMLElement>("[data-accordion-chevron]");
        if (!content) return;
        const isOpen = trigger.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          gsap.to(content, { height: 0, duration: 0.25, ease: "power2.inOut" });
          gsap.to(chevron, { rotate: 0, duration: 0.2 });
          trigger.setAttribute("aria-expanded", "false");
        } else {
          gsap.set(content, { height: "auto" });
          const target = content.scrollHeight;
          gsap.fromTo(content, { height: 0 }, { height: target, duration: 0.25, ease: "power2.inOut" });
          gsap.to(chevron, { rotate: 180, duration: 0.2 });
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    }
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>("[data-accordion]:not([data-accordion-bound])").forEach((root) => {
      root.dataset.accordionBound = "true";
      initAccordion(root);
    });
  }

  document.addEventListener("astro:page-load", initAll);
  initAll();
</script>
