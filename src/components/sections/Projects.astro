---
import BlurFade from "@/components/BlurFade.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { DATA } from "@/data/resume";

const BLUR_FADE_DELAY = 0.04;
---

<section id="projects">
  <div class="flex min-h-0 flex-col gap-y-8">
    <div class="flex flex-col items-center justify-center gap-y-4">
      <div class="flex w-full items-center">
        <div class="h-px flex-1 bg-linear-to-r from-transparent from-5% via-border via-95% to-transparent"></div>
        <div class="z-10 rounded-xl border bg-primary px-4 py-1">
          <span class="text-sm font-medium text-background">Mis Proyectos</span>
        </div>
        <div class="h-px flex-1 bg-linear-to-l from-transparent from-5% via-border via-95% to-transparent"></div>
      </div>
      <div class="flex flex-col items-center justify-center gap-y-3">
        <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl">Echa un vistazo a mi trabajo</h2>
        <p class="text-balance text-center text-muted-foreground md:text-lg/relaxed lg:text-base/relaxed xl:text-lg/relaxed">
          Estos son algunos de los proyectos en los que he trabajado, desde aplicaciones full stack hasta
          herramientas de gestión.
        </p>
      </div>
    </div>
    <div class="flex flex-col gap-6">
      {
        DATA.projects.map((project, id) => (
          <BlurFade delay={BLUR_FADE_DELAY * 12 + id * 0.05}>
            <ProjectCard
              href={project.href}
              title={project.title}
              description={project.description}
              dates={project.dates}
              tags={project.technologies}
              image={project.image}
              video={project.video}
              links={project.links}
            />
          </BlurFade>
        ))
      }
    </div>
  </div>
</section>
